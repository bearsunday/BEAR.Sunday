<?xml version="1.0"?>
<psalm
    errorLevel="1"
    phpVersion="8.2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    autoloader="demo/autoload.php"
    findUnusedPsalmSuppress="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="demo/public"/>
            <directory name="tests"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- Framework extension points: callers live in Ray.Di/AOP and downstream apps, invisible to standalone analysis -->
        <UnusedClass errorLevel="suppress"/>
        <PossiblyUnusedMethod errorLevel="suppress"/>
        <PossiblyUnusedReturnValue errorLevel="suppress"/>
        <!-- DefaultSchemeHost::$value is read by Ray.Di via the qualifier, not this repo; promoted properties ignore @psalm-suppress -->
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <file name="src/Annotation/DefaultSchemeHost.php"/>
            </errorLevel>
        </PossiblyUnusedProperty>
    </issueHandlers>
</psalm>
